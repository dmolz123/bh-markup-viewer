# Copy to .env for local dev (never commit .env). On Render, set these in the
# service's Environment tab instead.
#
# ---- Recommended: OAuth auto-refresh (hands-off) -------------------------
# Studio uses the authorization-code flow with offline_access, which returns a
# long-lived refresh token. Give the server your app credentials + a refresh
# token and it keeps access tokens fresh on its own (and re-refreshes on 401).
BLUEBEAM_CLIENT_ID=
BLUEBEAM_CLIENT_SECRET=

# A refresh token. Two ways to get one:
#   (a) leave this blank, deploy, then visit  https://<your-app>/auth/login
#       once — the server captures and stores the refresh token itself; or
#   (b) paste a refresh token you already have here.
BLUEBEAM_REFRESH_TOKEN=

# Optional. Exact public base URL of this app, used to build the OAuth
# redirect_uri (<APP_BASE_URL>/auth/callback). Set this if your OAuth client
# requires an exact registered redirect URI. If blank, it's derived from the
# incoming request. Example: https://bh-markup-viewer.onrender.com
APP_BASE_URL=

# Optional. Where to persist a rotated refresh token so in-instance restarts
# survive. Defaults to the OS temp dir.
# TOKEN_STORE_PATH=

# ---- Fallback: paste a short-lived access token yourself ------------------
# Used only if the OAuth vars above are not set. Expires; you re-paste it.
BLUEBEAM_TOKEN=

# ---- Misc ----------------------------------------------------------------
# Optional. Defaults to https://api.bluebeam.com
BLUEBEAM_API_BASE=https://api.bluebeam.com
# Optional. Render sets PORT automatically; only needed for local dev.
PORT=3000
