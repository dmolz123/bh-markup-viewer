# Copy to .env for local dev (never commit .env). On Render, set these in the
# service's Environment tab instead.

# Studio OAuth2 access token (JWT). Sent as: Authorization: Bearer <token>.
# Studio access tokens are short-lived — refresh this value when calls start
# returning 401.
BLUEBEAM_TOKEN=

# Optional. Defaults to https://api.bluebeam.com
BLUEBEAM_API_BASE=https://api.bluebeam.com

# Optional. Render sets PORT automatically; only needed for local dev.
PORT=3000
